{
  "name": "companion-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    
    "models:seed": "tsx scripts/seed-models.ts",
    "models:eval": "tsx --env-file=.env scripts/language-eval.ts",
    "openapi": "tsx scripts/openapi.ts",
    "prefetch-model": "tsx scripts/prefetch-model.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@hono/zod-openapi": "^1.6.3",
    "@huggingface/transformers": "^4.3.1",
    "firebase-admin": "^14.5.0",
    "hono": "^4.13.13",
    "mongodb": "^7.7.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/web-push": "^3.6.4",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "onnxruntime-node@1.30.0": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "@firebase/util@1.15.3": true,
    "mongodb-memory-server": false
  }
}
