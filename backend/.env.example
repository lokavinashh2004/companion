# Backend secrets. Copy to .env for local runs; on Render set them in the dashboard. NEVER commit .env.
NODE_ENV=development
PORT=8787
ALLOWED_ORIGINS=http://localhost:5173

# Firebase (Project settings → General → Project ID; Service accounts → Generate new private key)
FIREBASE_PROJECT_ID=
# Paste the JSON on one line, or base64 of the file
FIREBASE_SERVICE_ACCOUNT=

# MongoDB (Atlas → Database → Connect → Drivers). Required.
MONGODB_URI=
MONGODB_DB=companion
# Public URL of this API, used inside push notifications (Render sets RENDER_EXTERNAL_URL automatically).
PUBLIC_API_URL=

OPENROUTER_API_KEY=
USDA_API_KEY=
LLM_DAILY_BUDGET=50
LLM_SUMMARY_RESERVE=2

# Random string; the external scheduler (cron-job.org) sends it as the x-cron-secret header
CRON_SECRET=

# Web Push keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Random string for signing medicine notification actions
MED_ACTION_SECRET=

MODEL_DIR=./models
