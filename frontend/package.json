{
  "name": "companion-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint src",
    "test": "vitest run",
    "check:locales": "node --experimental-strip-types scripts/check-locales.ts",
    "api:types": "npx --yes -p typescript@5 -p openapi-typescript@7 openapi-typescript ../backend/openapi.json -o src/lib/api-schema.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/anek-tamil": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "firebase": "^13.0.0",
    "i18next": "^26.4.2",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.16",
    "react-router": "^8.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.2",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true
  }
}
