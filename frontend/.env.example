# Public values only: everything prefixed VITE_ is bundled into the website.
# Set these in Vercel → Project → Settings → Environment Variables.
# Your Render backend URL, e.g. https://companion-backend.onrender.com (http://localhost:8787 for local runs)
VITE_API_URL=http://localhost:8787
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Web Push public key (same as backend VAPID_PUBLIC_KEY)
VITE_VAPID_PUBLIC_KEY=
